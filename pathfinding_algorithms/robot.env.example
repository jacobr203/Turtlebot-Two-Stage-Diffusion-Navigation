# Copy to robot.env and fill in. robot.env is gitignored: never commit an
# address or a credential. Only needed for real-robot runs; simulation
# (--sim) does not use these.
#
# Prefer SSH keys over a password:
#   ssh-copy-id <user>@<robot-ip>
# then leave ROBOT_PASS empty and run.sh will use the key.
ROBOT_IP=
ROBOT_USER=
ROBOT_PASS=
WORKSTATION_IP=
