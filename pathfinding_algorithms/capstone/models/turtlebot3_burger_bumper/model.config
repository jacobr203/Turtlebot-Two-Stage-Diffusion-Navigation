<?xml version="1.0"?>
<model>
  <name>turtlebot3_burger_bumper</name>
  <version>1.0</version>
  <sdf version="1.5">model.sdf</sdf>
  <author>
    <name>Jacob Rego</name>
    <email>jacobr203@gmail.com</email>
  </author>
  <description>
    TurtleBot3 Burger (apt turtlebot3_gazebo copy) plus a contact sensor on
    base_collision publishing gazebo_msgs/ContactsState on /bumper_states.
    Used for ground-truth collision detection in BARN expert-data collection
    and evaluation. Meshes resolve via model://turtlebot3_common from the apt
    package.
  </description>
</model>
