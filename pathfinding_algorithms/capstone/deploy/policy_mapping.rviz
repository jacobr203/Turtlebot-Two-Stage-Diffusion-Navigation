Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Tree Height: 500
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Alpha: 0.7
      Topic:
        Value: /map
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/Map
      Name: FaceCoverage
      Alpha: 0.9
      Topic:
        Value: /seek/coverage
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: costmap
      Draw Behind: true
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Swatches
      Topic:
        Value: /seek/swatches
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Enabled: true
      Show Names: true
      Marker Scale: 0.5
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 255; 84; 84
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/Path
      Name: PolicyWaypoints
      Topic:
        Value: /policy/waypoints
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Line Style: Billboards
      Line Width: 0.06
      Color: 0; 255; 255
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Subgoal
      Topic:
        Value: /policy/subgoal
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Axes
      Axes Length: 0.25
      Axes Radius: 0.03
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 300
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      # Covariance must be OFF: the gazebo diff-drive plugin fills unused
      # covariance dims with 1e12, which renders as view-filling yellow
      # ellipsoids (rviz defaults this to on if omitted)
      Covariance:
        Orientation:
          Value: false
        Position:
          Value: false
        Value: false
      Shape:
        Shaft Length: 0.08
        Shaft Radius: 0.01
        Head Length: 0.04
        Head Radius: 0.02
        Color: 60; 130; 220
        Value: Arrow
      Enabled: true
      Value: true
  Global Options:
    Background Color: 34; 36; 41
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Pitch: 1.4
      Yaw: 1.57
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Name: Current View
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1200
