# Build output
build/
install/
log/
__pycache__/
*.pyc
.pytest_cache/
*.swp
*~
.DS_Store
.vscode/

# Robot credentials: copy robot.env.example to robot.env
robot.env
**/robot.env
*.env
!*.env.example

# Maps: measured reference maps are tracked, per-run maps are not
*.pgm
!pathfinding_algorithms/maps/reference/*.pgm
!pathfinding_algorithms/capstone/evaluation/arenas/*.pgm
pathfinding_algorithms/maps/sim/
pathfinding_algorithms/maps/real/

# Regenerated by capstone/barn and capstone/expert scripts
pathfinding_algorithms/capstone/.venv/
pathfinding_algorithms/capstone/barn/raw/
pathfinding_algorithms/capstone/barn/worlds/
pathfinding_algorithms/capstone/barn/worlds_fast/
pathfinding_algorithms/capstone/barn/worlds_color/
pathfinding_algorithms/capstone/barn/targets/
pathfinding_algorithms/capstone/barn/maps/
pathfinding_algorithms/capstone/expert/data/

# Checkpoints and raw results; only the summaries are tracked
pathfinding_algorithms/capstone/**/runs/
pathfinding_algorithms/capstone/results/*
!pathfinding_algorithms/capstone/results/summary/
!pathfinding_algorithms/capstone/results/color_test/
